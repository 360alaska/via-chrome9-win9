; VIA Chrome9 (VX800 / VX820 / VX855 / VX875) display driver for Windows 98; the display driver's skeleton is from VMDisp9x (MIT).
[Version]
Signature="$CHICAGO$"
Class=DISPLAY
Provider=%Provider%
DriverVer=11/11/2026,10.597.0.0

[Manufacturer]
%Mfg%=VXModels

[VXModels]
; .579: one driver for the Chrome9 graphics of the VX chipsets
%DeviceHC3%=VXInstall,PCI\VEN_1106&DEV_1122
%DeviceHCM%=VXInstall,PCI\VEN_1106&DEV_5122

[DestinationDirs]
VXCopy=11

[SourceDisksNames]
1="VIA Chrome9 display driver",,0

[SourceDisksFiles]
CHROME9.DRV=1
CHROME9.VXD=1
VXDDRAW.DLL=1
VXGL.DLL=1

[VXInstall]
CopyFiles=VXCopy
DelReg=VXDelete
AddReg=VXRegistry,VXMonitor,VXOpenGL

[VXCopy]
CHROME9.DRV,,,0x00000004
CHROME9.VXD,,,0x00000004
VXDDRAW.DLL,,,0x00000004
VXGL.DLL,,,0x00000004

[VXDelete]
HKR,DEFAULT
HKR,MODES
HKR,CURRENT
HKLM,Software\Microsoft\Windows\CurrentVersion\OpenGLdrivers,VX855GL

[VXMonitor]
; Win98 caps the Display Properties slider at the monitor type's MaxResolution (Plug and Play Monitor: 1600x1200)
HKLM,"System\CurrentControlSet\Services\Class\Monitor\0000",MaxResolution,,"1920,1200"
HKLM,"System\CurrentControlSet\Services\Class\Monitor\0001",MaxResolution,,"1920,1200"

; v10.239: the OpenGL ICD (the DRV names it Chrome9GL in its OPENGL_GETINFO escape; VX855GL before .580)
[VXOpenGL]
HKLM,Software\Microsoft\Windows\CurrentVersion\OpenGLdrivers,Chrome9GL,,%11%\VXGL.DLL

[VXRegistry]
HKR,,Ver,,4.0
HKR,,DevLoader,,*vdd
HKR,DEFAULT,drv,,CHROME9.DRV
HKR,DEFAULT,minivdd,,CHROME9.VXD
HKR,DEFAULT,vdd,,*vdd
HKR,DEFAULT,Mode,,"16,800,600"
HKR,DEFAULT,RefreshRate,,-1
HKR,DEFAULT,DDC,,0
HKR,"MODES\4\640,480",drv,,vga.drv
