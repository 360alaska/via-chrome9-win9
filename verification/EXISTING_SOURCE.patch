+  push edx
+  push ecx
+  push esi
+  push edi
+  mov edx,OP_VX_BIND
+  mov esi,[fp]
+  mov edi,[ep]
+  call dword ptr [VXD_VM]
+  mov [result],ecx
+  pop edi
+  pop esi
+  pop ecx
+  pop edx
+  pop eax
+ }
+ return (WORD)result;
+}
